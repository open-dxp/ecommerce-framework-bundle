		-
			message: "#^Parameter \\#1 \\$product of method OpenDxp\\\\Bundle\\\\EcommerceFrameworkBundle\\\\Model\\\\AbstractOrderItem\\:\\:setProduct\\(\\) expects OpenDxp\\\\Model\\\\Element\\\\AbstractElement\\|null, OpenDxp\\\\Bundle\\\\EcommerceFrameworkBundle\\\\Model\\\\CheckoutableInterface given\\.$#"
			count: 1
