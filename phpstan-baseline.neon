			path: src/OfferTool/AbstractOfferToolProduct.php

		-
			message: "#^Parameter \\#1 \\$product of method OpenDxp\\\\Bundle\\\\EcommerceFrameworkBundle\\\\OfferTool\\\\AbstractOfferItem\\:\\:setProduct\\(\\) expects OpenDxp\\\\Model\\\\Element\\\\AbstractElement\\|null, OpenDxp\\\\Bundle\\\\EcommerceFrameworkBundle\\\\Model\\\\CheckoutableInterface given\\.$#"
