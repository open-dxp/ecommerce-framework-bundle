		-
			message: "#^Parameter \\#1 \\$categories of method OpenDxp\\\\Bundle\\\\EcommerceFrameworkBundle\\\\PricingManager\\\\Condition\\\\CatalogCategory\\:\\:setCategories\\(\\) expects array\\<OpenDxp\\\\Bundle\\\\EcommerceFrameworkBundle\\\\Model\\\\AbstractCategory\\>, array\\<int\\<0, max\\>, OpenDxp\\\\Model\\\\DataObject\\\\Concrete\\> given\\.$#"
			count: 1
