		-
			message: "#^Parameter \\#1 \\$products of method OpenDxp\\\\Bundle\\\\EcommerceFrameworkBundle\\\\PricingManager\\\\Condition\\\\CatalogProduct\\:\\:setProducts\\(\\) expects array\\<OpenDxp\\\\Bundle\\\\EcommerceFrameworkBundle\\\\Model\\\\AbstractProduct\\>, array\\<int\\<0, max\\>, OpenDxp\\\\Model\\\\DataObject\\\\Concrete\\> given\\.$#"
