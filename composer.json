{
    "name": "open-dxp/ecommerce-framework-bundle",
    "license": "GPL-3.0+",
    "type": "opendxp-bundle",
    "description": "OpenDXP Ecommerce Bundle",
    "config": {
        "sort-packages": true,
        "preferred-install": {
            "open-dxp/opendxp": "source",
            "*": "dist"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": false,
            "symfony/runtime": true
        }
    },
    "require": {
        "php": "~8.3.0 || ~8.4.0 || ~8.5.0",
        "open-dxp/opendxp": "^1.5",
        "open-dxp/personalization-bundle": "^1.0",
        "open-dxp/google-marketing-bundle": "^1.0",
        "knplabs/knp-paginator-bundle": "^6.0",
        "symfony/webpack-encore-bundle": "^2.0",
        "symfony/form": "^7.4"
    },
    "require-dev": {
        "open-dxp/test-foundation": "^1.1",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-symfony": "^2.0.9",
        "symfony/dotenv": "^7.4",
        "symfony/runtime": "^7.4"
    },
    "suggest": {
        "open-dxp/elasticsearch-client-bundle": "Required for a product index in Elasticsearch",
        "open-dxp/opensearch-client-bundle": "Required for a product index in OpenSearch",
        "webmozarts/console-parallelization": "Required to run the index commands in parallel"
    },
    "autoload": {
        "psr-4": {
            "OpenDxp\\Bundle\\EcommerceFrameworkBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenDxp\\Bundle\\EcommerceFrameworkBundle\\Tests\\": "tests/"
        }
    },
    "extra": {
        "opendxp": {
            "bundles": [
                "OpenDxp\\Bundle\\EcommerceFrameworkBundle\\OpenDxpEcommerceFrameworkBundle"
            ]
        },
        "opendxp-test": {
            "optional": {
                "open-dxp/elasticsearch-client-bundle": "^1.0.0",
                "open-dxp/opensearch-client-bundle": "^1.0.0"
            }
        }
    }
}
